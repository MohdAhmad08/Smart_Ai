# Copy to .env (repo root) before running anything.
#   cp .env.example .env    # then edit credentials
# This is the ONLY .env file in the project — every entry point (backend,
# ml/, rabbitmq/consumer, rabbitmq/producer/*) loads this exact file
# regardless of which directory it's run from.
# (.env is git-ignored — never commit real credentials.)

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
# Local (host) processes use this:
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/machine_telemetry?charset=utf8mb4
# Containers use the in-network hostname (leave default unless you changed creds):
# DATABASE_URL_DOCKER=mysql+pymysql://root:root@mysql:3306/machine_telemetry?charset=utf8mb4

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest
RABBIT_MQ_HOST=localhost
RABBIT_MQ_PORT=5672

RABBIT_MQ_EXCHANGE=scada_data
RABBIT_MQ_QUEUE=scada_data_queue
RABBIT_MQ_ROUTING_KEY=scada.tag.data
RABBIT_MQ_EVENT_QUEUE=machine_event_queue
RABBIT_MQ_EVENT_ROUTING_KEY=scada.machine.event

RABBIT_MQ_HEALTH_DATA_QUEUE=sensor_health_data_queue
RABBIT_MQ_HEALTH_DATA_ROUTING_KEY=scada.sensor.health

# ── Generator / Publisher ────────────────────────────────────────────────────
GEN_MACHINES=5
GEN_SEED=42
GEN_LIVE_INTERVAL=3.0
GEN_DT_SECONDS=3.0
CHECKPOINT_EVERY=200

# On publisher startup, race any machine whose checkpoint sim_ts is behind
# the newest timestamp already in machine_readings up to that point (no
# sleep, readings not published — only failure/repair events) before
# switching to normal real-time streaming. Set to 0 to always stream at
# real (sim-second per wall-second) speed instead.
GEN_FAST_FORWARD=1
# GEN_FF_CHECKPOINT_EVERY=20000

# Backfill-specific (override at CLI: GEN_DT_SECONDS=30 python backfill.py)
GEN_SIM_WEEKS=12
GEN_ACCEL=0.4
GEN_BATCH_SIZE=500
# GEN_WORKERS=              # defaults to min(GEN_MACHINES, cpu_count())
# GEN_NO_CALENDAR=1

# ── ML lifecycle ──────────────────────────────────────────────────────────────
# auto = champion/challenger promotes automatically when better by margin
# manual = new models stay in Staging until `python -m ml.registry --promote vN`
PROMOTE_MODE=auto
PROMOTE_MARGIN=0.005
# MLFLOW_TRACKING_URI=http://localhost:5000   # defaults to sqlite:///ml/mlflow.db locally
# MLFLOW_MODEL_NAME=machine-pdm
# MLFLOW_EXPERIMENT=machine-pdm

# ── ML scheduler (ml/schedule.py) ────────────────────────────────────────────
# SEAL_HOUR=1
# RETRAIN_HOUR=2
# DRIFT_EVERY_H=6
# FEEDBACK_EVERY_H=1
# RETRAIN_MIN_NEW_FAILURES=3
# RETRAIN_COOLDOWN_H=12
